# Browser-visible portal configuration. These are not server secrets.
# Do not put a database URL, service role key, or Supabase secret key here.

# Supabase project URL, for example https://your-project.supabase.co
VITE_SUPABASE_URL=

# Supabase publishable key. This is safe to ship in the browser.
# It is not the service-role or secret key.
VITE_SUPABASE_PUBLISHABLE_KEY=

# Mawahib API origin including /api/v1, for example http://127.0.0.1:3000/api/v1
# The portal sends the staff access token in the Authorization header.
VITE_API_BASE_URL=
